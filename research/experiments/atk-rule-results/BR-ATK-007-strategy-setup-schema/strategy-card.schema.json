{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Replay-Man Strategy Card",
  "type": "object",
  "required": ["id", "version", "universe", "context", "setup", "trigger", "invalidation", "outcomes", "validation"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "universe": {
      "type": "object",
      "required": ["groups", "intervals"],
      "properties": {
        "groups": {"type": "array", "items": {"enum": ["bist_equities", "bist_indices", "global_indices", "metals", "fx", "energy"]}, "minItems": 1},
        "symbols": {"type": "array", "items": {"type": "string"}},
        "intervals": {"type": "array", "items": {"enum": ["1h", "2h", "4h", "1d"]}, "minItems": 1},
        "volume_required": {"type": "boolean"}
      }
    },
    "context": {"$ref": "#/$defs/expression"},
    "setup": {"$ref": "#/$defs/expression"},
    "trigger": {"$ref": "#/$defs/expression"},
    "invalidation": {"$ref": "#/$defs/expression"},
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "implementation", "parameters", "known_at"],
        "properties": {
          "id": {"type": "string"},
          "implementation": {"type": "string"},
          "parameters": {"type": "object"},
          "known_at": {"enum": ["bar_close", "confirmed_pivot", "completed_higher_timeframe"]},
          "data_requirements": {"type": "array", "items": {"enum": ["open", "high", "low", "close", "volume", "cross_market", "external"]}}
        }
      }
    },
    "outcomes": {
      "type": "object",
      "required": ["horizons", "benchmark", "mfe_mae", "costs"],
      "properties": {
        "horizons": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "benchmark": {"enum": ["raw", "XU100_excess", "asset_class_reference"]},
        "mfe_mae": {"type": "boolean"},
        "costs": {"type": "array", "items": {"type": "number", "minimum": 0}}
      }
    },
    "validation": {
      "type": "object",
      "required": ["chronological_split", "common_calendar", "minimum_symbols", "parameter_neighbourhood", "preserve_negative_results"],
      "properties": {
        "chronological_split": {"const": [0.6, 0.2, 0.2]},
        "common_calendar": {"type": "boolean"},
        "minimum_symbols": {"type": "integer", "minimum": 1},
        "parameter_neighbourhood": {"type": "boolean"},
        "preserve_negative_results": {"const": true}
      }
    },
    "execution": {"enum": ["research_only", "deferred_execution_portfolio"]},
    "ob_fvg": {"enum": ["not_used", "deferred_ob_fvg", "user_system_reference"]}
  },
  "$defs": {
    "expression": {
      "type": "object",
      "required": ["operator", "operands", "known_at"],
      "properties": {
        "operator": {"enum": ["and", "or", "not", "gt", "gte", "lt", "lte", "cross_up", "cross_down", "within", "event"]},
        "operands": {"type": "array", "minItems": 1},
        "known_at": {"enum": ["bar_close", "confirmed_pivot", "completed_higher_timeframe"]}
      }
    }
  }
}
